{
	"name": "@joshuafolkken/app-kit",
	"version": "0.71.0",
	"private": false,
	"packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"keywords": [
		"svelte"
	],
	"files": [
		"dist",
		"eslint",
		"tsconfig",
		"cspell",
		"lefthook",
		"templates",
		"k6",
		".github/workflows/dast.yml",
		".github/workflows/load.yml",
		"zap-baseline.conf",
		"!dist/**/*.test.*",
		"!dist/check/**",
		"!dist/cloudflare/**",
		"!dist/dast/**",
		"!dist/lint-guards/**",
		"!dist/process/**",
		"!dist/verify/**"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"svelte": "./dist/theme/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js"
		},
		"./security": {
			"types": "./dist/security/index.d.ts",
			"svelte": "./dist/security/index.js",
			"default": "./dist/security/index.js"
		},
		"./security/e2e": {
			"types": "./dist/security/e2e.d.ts",
			"svelte": "./dist/security/e2e.js",
			"default": "./dist/security/e2e.js"
		},
		"./eslint/sveltekit": "./eslint/sveltekit.js",
		"./tsconfig/sveltekit": {
			"types": "./tsconfig/sveltekit.json",
			"default": "./tsconfig/sveltekit.json"
		},
		"./cspell/sveltekit": "./cspell/sveltekit.yaml"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"bin": {
		"josh-app": "./dist/scripts/josh-app.js"
	},
	"imports": {
		"#check/*": "./src/lib/check/*",
		"#cloudflare/*": "./src/lib/cloudflare/*",
		"#dast/*": "./src/lib/dast/*",
		"#load/*": "./src/lib/load/*",
		"#process/*": "./src/lib/process/*",
		"#verify/*": "./src/lib/verify/*",
		"#version/*": "./src/lib/version/*"
	},
	"scripts": {
		"preinstall": "pnpm dlx @aikidosec/safe-chain setup-ci",
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --local",
		"prepare": "pnpm prepare:gen && pnpm prepare:sync && pnpm prepare:lefthook && pnpm prepare:gh-packages",
		"prepare:gen": "[ ! -f wrangler.jsonc ] || pnpm gen",
		"prepare:sync": "svelte-kit sync || echo ''",
		"prepare:lefthook": "[ -n \"$CI\" ] || ! command -v lefthook >/dev/null 2>&1 || lefthook install",
		"prepare:gh-packages": "[ -n \"$CI\" ] || ! command -v tsx >/dev/null 2>&1 || tsx node_modules/@joshuafolkken/kit/scripts/fix-gh-packages.ts",
		"prepack": "svelte-kit sync && svelte-package && pnpm run build:scripts && publint",
		"build:scripts": "pnpm exec esbuild scripts/josh-app.ts --bundle --platform=node --packages=external --outdir=dist/scripts/ --format=esm --banner:js='#!/usr/bin/env node'",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "node -e \"const fs=require('node:fs');const d='.svelte-kit/cloudflare';if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>f.startsWith('_worker.')&&fs.rmSync(d+'/'+f,{force:true}))\"",
		"josh": "josh",
		"josh-app": "tsx scripts/josh-app.ts",
		"size-limit": "size-limit"
	},
	"dependencies": {
		"eslint-plugin-svelte": "^3.22.0",
		"typescript-eslint": "^8.66.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/kit": "^1.63.0",
		"@playwright/test": "^1.62.1",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
		"@size-limit/file": "^13.0.3",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"@vitest/browser-playwright": "^4.1.10",
		"cspell": "^10.0.1",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.9.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.22",
		"rollup-plugin-visualizer": "^7.0.1",
		"secretlint": "^13.0.4",
		"size-limit": "^13.0.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0",
		"wrangler": "^4.118.0"
	},
	"peerDependencies": {
		"@joshuafolkken/kit": ">=1.12.0",
		"eslint": "^10.0.0",
		"svelte": "^5.0.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
			"onFail": "error"
		}
	},
	"size-limit": [
		{
			"path": ".svelte-kit/output/client/_app/immutable/**/*.js",
			"limit": "500 kB"
		}
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js"
}
