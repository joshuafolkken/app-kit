{
	"name": "@joshuafolkken/app-kit",
	"version": "0.126.0",
	"private": false,
	"license": "MIT",
	"packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/joshuafolkken/app-kit.git"
	},
	"keywords": [
		"svelte"
	],
	"files": [
		"dist",
		"eslint",
		"tsconfig",
		"cspell",
		"lefthook",
		"templates",
		"k6",
		".github/workflows/dast.yml",
		".github/workflows/load.yml",
		"zap-baseline.conf",
		"josh-app.config.json",
		"!dist/**/*.test.*",
		"!dist/check/**",
		"!dist/cloudflare/**",
		"!dist/dast/**",
		"!dist/lint-guards/**",
		"!dist/process/**",
		"!dist/shot/**",
		"!dist/verify/**"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme": {
			"types": "./dist/theme/index.d.ts",
			"svelte": "./dist/theme/index.js"
		},
		"./i18n": {
			"types": "./dist/i18n/index.d.ts",
			"svelte": "./dist/i18n/index.js"
		},
		"./security": {
			"types": "./dist/security/index.d.ts",
			"svelte": "./dist/security/index.js",
			"default": "./dist/security/index.js"
		},
		"./security/e2e": {
			"types": "./dist/security/e2e.d.ts",
			"svelte": "./dist/security/e2e.js",
			"default": "./dist/security/e2e.js"
		},
		"./eslint/sveltekit": "./eslint/sveltekit.js",
		"./tsconfig/sveltekit": {
			"types": "./tsconfig/sveltekit.json",
			"default": "./tsconfig/sveltekit.json"
		},
		"./cspell/sveltekit": "./cspell/sveltekit.yaml"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"bin": {
		"josh-app": "./dist/scripts/josh-app.js"
	},
	"imports": {
		"#check/*": "./src/lib/check/*",
		"#cloudflare/*": "./src/lib/cloudflare/*",
		"#dast/*": "./src/lib/dast/*",
		"#load/*": "./src/lib/load/*",
		"#process/*": "./src/lib/process/*",
		"#shot/*": "./src/lib/shot/*",
		"#verify/*": "./src/lib/verify/*",
		"#version/*": "./src/lib/version/*"
	},
	"scripts": {
		"preinstall": "node -e \"if(!process.env.CI&&!process.env.GLOBAL_AGENT_HTTP_PROXY)console.warn('Warning: safe-chain (@aikidosec/safe-chain) is not scanning this install because its shell integration is not active. Install it with the hash-verified steps at https://github.com/joshuafolkken/kit/blob/main/SECURITY.md#installing-safe-chain - then restart your terminal.')\"",
		"dev": "DEV_PORT=$(josh port dev) && vite dev --port $DEV_PORT --strictPort",
		"build": "vite build && pnpm run prepack",
		"preview": "PREVIEW_PORT=$(josh port preview) && wrangler dev .svelte-kit/cloudflare/_worker.js --port $PREVIEW_PORT --local",
		"prepare": "pnpm prepare:gen && pnpm prepare:sync && pnpm prepare:lefthook && pnpm prepare:gh-packages",
		"prepare:gen": "[ ! -f wrangler.jsonc ] || pnpm gen",
		"prepare:sync": "svelte-kit sync || echo ''",
		"prepare:lefthook": "[ -n \"$CI\" ] || ! command -v lefthook >/dev/null 2>&1 || if git rev-parse --show-toplevel >/dev/null 2>&1; then lefthook install; else echo 'lefthook: no Git work tree here, so the hooks are not installed. After git init, run: pnpm prepare'; fi",
		"prepare:gh-packages": "[ -n \"$CI\" ] || ! command -v tsx >/dev/null 2>&1 || tsx node_modules/@joshuafolkken/kit/scripts/gh/fix-gh-packages.ts",
		"prepack": "svelte-kit sync && svelte-package && pnpm run build:scripts && publint",
		"build:scripts": "pnpm exec esbuild scripts/josh-app.ts --bundle --platform=node --packages=external --outdir=dist/scripts/ --format=esm --banner:js='#!/usr/bin/env node'",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "pnpm gen:pre && wrangler types",
		"gen:pre": "node -e \"const fs=require('node:fs');const d='.svelte-kit/cloudflare';if(fs.existsSync(d))fs.readdirSync(d).forEach(f=>f.startsWith('_worker.')&&fs.rmSync(d+'/'+f,{force:true}))\"",
		"josh": "josh",
		"josh-app": "tsx scripts/josh-app.ts",
		"size-limit": "size-limit"
	},
	"dependencies": {
		"eslint-plugin-svelte": "^3.23.1",
		"typescript-eslint": "^8.71.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@joshuafolkken/kit": "^1.1387.0",
		"@playwright/test": "^1.64.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
		"@size-limit/file": "^14.2.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.3",
		"cspell": "^10.3.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"rollup-plugin-visualizer": "^7.1.1",
		"secretlint": "^13.0.7",
		"size-limit": "^14.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-fast-check": "^0.4.5",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.149.0"
	},
	"peerDependencies": {
		"@joshuafolkken/kit": ">=1.1387.0",
		"eslint": "^10.4.0",
		"svelte": "^5.0.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5",
			"onFail": "download"
		}
	},
	"size-limit": [
		{
			"path": ".svelte-kit/output/client/_app/immutable/**/*.js",
			"limit": "500 kB"
		}
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js"
}
