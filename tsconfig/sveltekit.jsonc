{
	// app-kit's SvelteKit tsconfig preset. Self-contained by necessity: TypeScript
	// cannot resolve a cross-package `extends` to a `.jsonc` via package exports
	// (TS6053), and a relative `node_modules` path differs between app-kit's own
	// tree and a consumer's nested tree. kit's own tsconfig/sveltekit.jsonc embeds
	// the base for the same reason. This moves ownership of the SvelteKit tsconfig
	// from kit to app-kit; consumers extend
	// `./node_modules/@joshuafolkken/app-kit/tsconfig/sveltekit.jsonc`.
	"compilerOptions": {
		// SvelteKit / bundler delta over the generic base.
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		// Generic base (kept in sync with @joshuafolkken/kit/tsconfig/base).
		"strict": true,
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowUnusedLabels": false,
		"allowUnreachableCode": false,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"isolatedModules": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noPropertyAccessFromIndexSignature": true,
		"verbatimModuleSyntax": true,
		"noEmitOnError": true,
		"useDefineForClassFields": true,
		"noUncheckedSideEffectImports": true
	}
}
